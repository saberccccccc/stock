{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stock-prediction.local/schemas/workflow_v2.schema.json",
  "title": "Project-native Qlib-aligned workflow v2 draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "governance", "data", "ranges",
    "dataset", "processors", "model", "checkpoint", "signal", "strategy",
    "ledger", "records", "evaluation"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "experiment_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formal", "selection_splits", "observation_splits", "forward_selection_allowed"],
      "properties": {
        "formal": {"const": true},
        "selection_splits": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["val_2024", "test_2025"]}},
        "observation_splits": {"type": "array", "uniqueItems": true, "items": {"enum": ["forward_2026"]}},
        "forward_selection_allowed": {"const": false},
        "parent_fit_end": {"$ref": "#/$defs/date"},
        "parent_selection_end": {"$ref": "#/$defs/date"}
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "max_data_date", "universe"],
      "properties": {
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dataSource"}},
        "max_data_date": {"$ref": "#/$defs/date"},
        "universe": {"type": "string", "minLength": 1},
        "physical_cache_reuse": {"type": "boolean"}
      }
    },
    "ranges": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_warmup", "train", "valid", "signal", "backtest"],
      "properties": {
        "feature_warmup": {"$ref": "#/$defs/dateRange"},
        "train": {"$ref": "#/$defs/dateRange"},
        "valid": {"$ref": "#/$defs/dateRange"},
        "signal": {"$ref": "#/$defs/dateRange"},
        "backtest": {"$ref": "#/$defs/dateRange"}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "feature_set", "label", "segments", "data_keys"],
      "properties": {
        "adapter": {"enum": ["project_v14_memmap", "project_tabular", "frozen_prediction"]},
        "feature_set": {"type": "string", "minLength": 1},
        "label": {
          "type": "object", "additionalProperties": false,
          "required": ["family", "horizon_index", "tail_purge_days"],
          "properties": {
            "family": {"type": "string", "minLength": 1},
            "horizon_index": {"type": "integer", "minimum": 0},
            "tail_purge_days": {"type": "integer", "minimum": 1}
          }
        },
        "segments": {"type": "object", "minProperties": 2, "additionalProperties": {"$ref": "#/$defs/dateRange"}},
        "data_keys": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"enum": ["raw", "infer", "learn"]}}
      }
    },
    "processors": {
      "type": "object", "additionalProperties": false,
      "required": ["shared", "infer", "learn", "state_policy"],
      "properties": {
        "shared": {"type": "array", "items": {"$ref": "#/$defs/processor"}},
        "infer": {"type": "array", "items": {"$ref": "#/$defs/processor"}},
        "learn": {"type": "array", "items": {"$ref": "#/$defs/processor"}},
        "state_policy": {
          "enum": ["fit_train_freeze_elsewhere", "frozen_parent_no_refit"]
        }
      }
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter", "config", "seed", "resource_limits"],
      "properties": {
        "adapter": {"enum": ["rolling_lgbm_alpha", "torch_strong_alpha", "frozen_artifact", "legacy_read_only"]},
        "config": {"type": "object"},
        "seed": {"type": "integer", "minimum": 0},
        "resource_limits": {
          "type": "object", "additionalProperties": false,
          "required": ["ram_gb", "gpu_vram_gb"],
          "properties": {
            "ram_gb": {"type": "number", "exclusiveMinimum": 0, "maximum": 16},
            "gpu_vram_gb": {"type": "number", "minimum": 0, "maximum": 8},
            "threads": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["rule", "selection_segment", "oos_selection_allowed"],
      "properties": {
        "rule": {"type": "string", "minLength": 1},
        "selection_segment": {"const": "valid"},
        "oos_selection_allowed": {"const": false}
      }
    },
    "signal": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "candidate_id", "score_time", "order_time", "transform"],
      "properties": {
        "schema": {"const": "prediction_frame_v1"},
        "candidate_id": {"type": "string", "minLength": 1},
        "comparison_candidate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "score_time": {"type": "string", "minLength": 1},
        "order_time": {"type": "string", "minLength": 1},
        "transform": {"type": "string", "minLength": 1}
      }
    },
    "strategy": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter", "params"],
      "properties": {
        "adapter": {"enum": ["retention", "topk_dropout", "portfolio_constructor"]},
        "params": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"adapter": {"const": "retention"}}},
          "then": {
            "properties": {
              "params": {
                "required": ["target_frac", "hold_frac", "rebalance_band", "max_new_names"],
                "properties": {
                  "target_frac": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
                  "hold_frac": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
                  "rebalance_band": {"type": "number", "minimum": 0, "maximum": 1},
                  "max_new_names": {"type": "integer", "minimum": 0}
                }
              }
            }
          }
        }
      ]
    },
    "ledger": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter", "execution_mode", "fill_price", "capitals", "stresses"],
      "properties": {
        "adapter": {"const": "official_open_ledger"},
        "execution_mode": {"const": "realistic"},
        "fill_price": {"const": "open"},
        "capitals": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"enum": [500000, 1000000]}},
        "stresses": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"enum": ["normal", "lag1", "cost2x", "capacity_3pct"]}}
      }
    },
    "records": {
      "type": "array", "minItems": 6, "uniqueItems": true,
      "items": {"enum": ["signal", "signal_analysis", "portfolio", "risk_attribution", "stress", "decision"]}
    },
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["selection_splits", "observation_splits", "primary_metrics", "ic_role"],
      "properties": {
        "selection_splits": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["val_2024", "test_2025"]}},
        "observation_splits": {"type": "array", "uniqueItems": true, "items": {"enum": ["forward_2026"]}},
        "primary_metrics": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"enum": ["annualized_return", "sharpe", "max_drawdown", "turnover", "cost", "capacity"]}},
        "ic_role": {"const": "diagnostic_only"}
      }
    }
  },
  "$defs": {
    "date": {"type": "string", "format": "date", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "dateRange": {
      "type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": {"start": {"$ref": "#/$defs/date"}, "end": {"$ref": "#/$defs/date"}}
    },
    "dataSource": {
      "type": "object", "additionalProperties": false, "required": ["role", "provider", "root", "pit"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "root": {"type": "string", "minLength": 1},
        "pit": {"type": "boolean"}
      }
    },
    "processor": {
      "type": "object", "additionalProperties": false, "required": ["name", "kind", "config"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["pit_alignment", "daily_cross_section", "train_fitted", "inference_only", "learning_only"]},
        "config": {"type": "object"},
        "state": {"type": ["object", "null"]}
      }
    }
  }
}
