{
  "schema_version": 1,
  "experiment_id": "workflow_rolling_compact_v1",
  "data": {
    "sources": [
      {"role": "research_market", "root": "data/raw"}
    ],
    "max_data_date": "2025-12-31"
  },
  "ranges": {
    "feature_warmup": {"start": "2010-01-04", "end": "2023-12-31"},
    "train": {"start": "2010-01-04", "end": "2023-12-31"},
    "valid": {"start": "2023-01-01", "end": "2024-12-31"},
    "signal": {"start": "2024-01-01", "end": "2025-12-31"},
    "backtest": {"start": "2024-01-01", "end": "2025-12-31"}
  },
  "features": {
    "set": "alpha158_compact_price_volume_v1",
    "transform_contract": {
      "type": "project_pit_daily_cross_section",
      "train_fitted_state": false,
      "feature_baseline": "alpha158_compact_price_volume_v1"
    }
  },
  "labels": {
    "family": "oo_lag1",
    "horizon_index": 4,
    "tail_purge_days": 7
  },
  "windows": {
    "type": "fixed_historical_oos",
    "selection_splits": ["val_2024", "test_2025"]
  },
  "model": {
    "adapter": "rolling_lgbm_alpha",
    "config": "configs/rolling_compact_lgbm_oo_lag1_workflow_v1.json"
  },
  "checkpoint": {
    "rule": "window_valid_l2_early_stopping",
    "forward_selection_allowed": false
  },
  "alpha": {
    "candidate_id": "workflow_rolling_compact_v1",
    "comparison_candidate_ids": ["ledger_path_v3_t0001_nolookahead"],
    "transform": "raw_cross_sectional_rank"
  },
  "strategy": {
    "adapter": "retention",
    "target_fracs": [0.006],
    "hold_fracs": [0.10],
    "rebalance_bands": [0.20],
    "max_new_names": [5],
    "exit_hold_fracs": [0],
    "switch_gap_fracs": [0]
  },
  "ledger": {
    "adapter": "official_open_ledger",
    "execution_mode": "realistic",
    "stresses": ["normal", "lag1", "cost2x", "capacity_3pct"],
    "capitals": [500000, 1000000]
  },
  "evaluation": {
    "splits": ["val_2024", "test_2025"]
  },
  "reports": {
    "scorecard": "registry_apm_scorecard",
    "attribution_required": true,
    "append_registry": true
  }
}
