{
  "schema_version": 1,
  "experiment_id": "formal_baseline_ledger_replay_v1",
  "data": {
    "sources": [
      {"role": "research_market", "root": "data/raw"}
    ],
    "max_data_date": "2025-12-31"
  },
  "ranges": {
    "feature_warmup": {"start": "2010-01-04", "end": "2023-12-31"},
    "train": {"start": "2010-01-04", "end": "2023-12-31"},
    "valid": {"start": "2024-01-01", "end": "2024-12-31"},
