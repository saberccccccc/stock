  "windows": {
    "type": "frozen_registry_evidence",
    "selection_splits": ["val_2024", "test_2025"]
  },
  "model": {
    "adapter": "frozen_registry_candidate",
    "candidate_ids": ["ledger_path_v3_t0001_nolookahead"]
  },
  "checkpoint": {
    "rule": "frozen_registered_artifact",
    "forward_selection_allowed": false
  },
  "alpha": {
    "transform": "registered_raw_signal",
    "candidate_ids": ["ledger_path_v3_t0001_nolookahead"]
  },
  "strategy": {
    "adapter": "retention",
    "contract": "project_native_strategy_only",
    "target_fracs": [0.006],
